source 'https://rubygems.org'

# Essential Jekyll gems
gem 'jekyll'
gem 'jekyll-archives'
gem 'jekyll-feed'
gem 'webrick'

# Optional plugins can stay grouped
group :jekyll_plugins do
  gem 'classifier-reborn'
  gem 'jekyll-diagrams'
  gem 'jekyll-email-protect'
  gem 'jekyll-imagemagick'
  gem 'jekyll-link-attributes'
  gem 'jekyll-minifier'
  gem 'jekyll-paginate-v2'
  gem 'jekyll-scholar'
  gem 'jekyll-sitemap'
  gem 'jekyll-twitter-plugin'
  gem 'jemoji'
  gem 'mini_racer'
  gem 'unicode_utils'
end

group :other_plugins do
  gem 'feedjira'
  gem 'httparty'
end
